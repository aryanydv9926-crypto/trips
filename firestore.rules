rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    //  EXISTING: Personal user data (unchanged behaviour)
    // ============================================================
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /discoveries/{id} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 100;
      }
      match /searches/{id} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.q is string
          && request.resource.data.q.size() <= 100;
      }

      // Travel Discovery favourites
      match /favoritePlaces/{id} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120;
      }

      // Movie Discovery favourites
      match /favoriteMovies/{id} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 160;
      }
    }

    // ============================================================
    //  TRIP SYNC – Collaborative rooms (UNCHANGED)
    // ============================================================

    function isMember(tripId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid));
    }

    function isOwner(tripId) {
      return request.auth != null
        && get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId == request.auth.uid;
    }

    match /tripInvites/{code} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.tripId is string
        && request.resource.data.active is bool
        && request.resource.data.tripName is string
        && request.resource.data.destination is string;

      allow update: if request.auth != null
        && resource.data.createdBy == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
    }

    match /trips/{tripId} {
      allow read: if isMember(tripId);

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.destination is string
        && request.resource.data.destination.size() <= 120;

      allow update: if isMember(tripId)
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if isOwner(tripId);

      match /members/{userId} {
        allow read: if isMember(tripId);

        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role in ['owner', 'member'];

        allow update: if isMember(tripId)
          && (request.auth.uid == userId || isOwner(tripId));

        allow delete: if isMember(tripId)
          && (request.auth.uid == userId || isOwner(tripId));
      }

      match /destinations/{docId} {
        allow read: if isMember(tripId);
        allow create, update, delete: if isMember(tripId);
      }
      match /itinerary/{docId} {
        allow read: if isMember(tripId);
        allow create, update, delete: if isMember(tripId);
      }
      match /hotels/{docId} {
        allow read: if isMember(tripId);
        allow create, update, delete: if isMember(tripId);
      }
      match /expenses/{docId} {
        allow read: if isMember(tripId);
        allow create, update, delete: if isMember(tripId);
      }
      match /notes/{docId} {
        allow read: if isMember(tripId);
        allow create, update, delete: if isMember(tripId);
      }
      match /chat/{docId} {
        allow read: if isMember(tripId);
        allow create: if isMember(tripId);
        allow update, delete: if false;
      }
    }
  }
}
